{
	"name": "@vitfoundation/ui",
	"version": "0.1.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/fixtures.*",
		"!dist/**/stories/**",
		"!dist/**/tests/**",
		"!dist/testing/**"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./ui": {
			"types": "./dist/components/ui/index.d.ts",
			"svelte": "./dist/components/ui/index.js",
			"default": "./dist/components/ui/index.js"
		},
		"./layout": {
			"types": "./dist/components/layout/index.d.ts",
			"svelte": "./dist/components/layout/index.js",
			"default": "./dist/components/layout/index.js"
		},
		"./weeklies": {
			"types": "./dist/components/weeklies/index.d.ts",
			"svelte": "./dist/components/weeklies/index.js",
			"default": "./dist/components/weeklies/index.js"
		},
		"./projects": {
			"types": "./dist/components/projects/index.d.ts",
			"svelte": "./dist/components/projects/index.js",
			"default": "./dist/components/projects/index.js"
		},
		"./team": {
			"types": "./dist/components/team/index.d.ts",
			"svelte": "./dist/components/team/index.js",
			"default": "./dist/components/team/index.js"
		},
		"./timeline": {
			"types": "./dist/components/timeline/index.d.ts",
			"svelte": "./dist/components/timeline/index.js",
			"default": "./dist/components/timeline/index.js"
		},
		"./jobs": {
			"types": "./dist/components/jobs/index.d.ts",
			"svelte": "./dist/components/jobs/index.js",
			"default": "./dist/components/jobs/index.js"
		},
		"./edit": {
			"types": "./dist/edit/index.d.ts",
			"svelte": "./dist/edit/index.js",
			"default": "./dist/edit/index.js"
		},
		"./config": {
			"types": "./dist/config/index.d.ts",
			"svelte": "./dist/config/index.js",
			"default": "./dist/config/index.js"
		},
		"./tokens.css": "./dist/styles/tokens.css",
		"./base.css": "./dist/styles/base.css"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^4.1.2",
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.38.0",
		"@playwright/test": "^1.56.1",
		"@storybook/addon-a11y": "^10.5.10",
		"@storybook/addon-docs": "^10.5.10",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "^10.5.10",
		"@storybook/sveltekit": "^10.5.10",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.47.1",
		"@sveltejs/package": "^2.5.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.0.5",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.0.7",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^16.4.0",
		"playwright": "^1.56.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"publint": "^0.3.14",
		"storybook": "^10.5.10",
		"svelte": "^5.57.0",
		"svelte-check": "^4.6.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.1",
		"vite": "^7.1.10",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.0.5",
		"vitest-browser-svelte": "^2.0.1"
	},
	"keywords": [
		"svelte"
	],
	"license": "MIT",
	"description": "Fundaci\u00f3 VIT's shared Svelte 5 component library with pluggable edit mode",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fndvit/VizVit-UI.git"
	},
	"publishConfig": {
		"access": "public"
	}
}
